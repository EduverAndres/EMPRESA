# Get a free API key at https://resend.com (Resend > API Keys)
RESEND_API_KEY=

# Where contact-form submissions are delivered. Defaults to the address
# in src/lib/site-config.ts if left empty.
CONTACT_TO_EMAIL=

# Sender address for the contact form email. IMPORTANT: until you verify a
# domain at https://resend.com/domains, Resend only lets you send from
# "onboarding@resend.dev" AND ONLY to the email address your Resend account
# was created with. If CONTACT_TO_EMAIL is a different address, sending will
# fail in production until you verify a domain and set this to an address on
# that domain, e.g. "NEXUS <contacto@tudominio.com>".
CONTACT_FROM_EMAIL=

# Get a free API key at https://aistudio.google.com/apikey (Gemini)
GEMINI_API_KEY=
# Optional: override the default chat model (gemini-2.5-flash)
GEMINI_MODEL=
